{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "webviews": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "notification:default",
    "dialog:allow-open",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "allow-bootstrap",
    "allow-open-session",
    "allow-kill-session",
    "allow-pty-attach",
    "allow-pty-write",
    "allow-pty-resize",
    "allow-pty-close",
    "allow-save-layout",
    "allow-tile-info",
    "allow-git-branches",
    "allow-project-files",
    "allow-search-files",
    "allow-reveal-path",
    "allow-browser-name",
    "allow-update-check",
    "allow-update-install",
    "allow-open-file",
    "allow-preview-file",
    "allow-run-targets",
    "allow-git-switch",
    "allow-list-projects",
    "allow-list-sessions",
    "allow-coffee-status",
    "allow-coffee-set",
    "allow-coffee-restore",
    "allow-coffee-uninstall",
    "allow-lock-desk",
    "allow-unlock-desk",
    "allow-is-locked",
    "allow-dropdown-apply",
    "allow-dropdown-leave",
    "allow-open-preview",
    "allow-preview-bounds",
    "allow-preview-visible",
    "allow-preview-close",
    "allow-preview-nav",
    "allow-read-text",
    "allow-write-text",
    "allow-open-external",
    "allow-chat-dir",
    "allow-usage",
    "allow-list-agents",
    "allow-create-project"
  ]
}
