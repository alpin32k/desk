{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "notification:default",
    "dialog:allow-open",
    "allow-bootstrap",
    "allow-open-session",
    "allow-kill-session",
    "allow-pty-attach",
    "allow-pty-write",
    "allow-pty-resize",
    "allow-pty-close",
    "allow-save-layout",
    "allow-tile-info",
    "allow-git-branches",
    "allow-git-switch",
    "allow-list-projects",
    "allow-list-sessions",
    "allow-coffee-status",
    "allow-coffee-set",
    "allow-coffee-restore",
    "allow-coffee-uninstall",
    "allow-lock-desk",
    "allow-unlock-desk",
    "allow-is-locked",
    "allow-open-preview",
    "allow-open-external",
    "allow-chat-dir",
    "allow-usage",
    "allow-list-agents",
    "allow-create-project"
  ]
}
